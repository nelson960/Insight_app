{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/py/insight/insight_app/storage/cache/view_*" },
        { "path": "$HOME/py/insight/insight_app/storage/cache/view_*.*" }
      ]
    }
  ]
}
